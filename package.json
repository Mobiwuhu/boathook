{
	"name": "boathook-workspace",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "bun x --bun biome check . && bun run check:deps && bun run check:sdk",
		"check:fix": "bun x --bun biome check --fix .",
		"format": "bun x --bun biome format --fix .",
		"lint": "bun x --bun biome lint .",
		"build": "bun run --cwd apps/cli build",
		"build:docker": "docker build --build-arg BUN_VERSION=$(cat .bun-version) -t boathook .",
		"release": "bun scripts/build-release.ts",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:fuzz": "bun test test/fuzz",
		"test:stress": "BOATHOOK_STRESS_ITERATIONS=500 bun test test/stress",
		"test:integration": "bun scripts/smoke/sessions.ts",
		"bench:regression": "bun run benchmarks/performance-regression.ts",
		"bench:competitive": "bun run benchmarks/competitive.ts",
		"bench:workloads": "bun run benchmarks/workloads.ts",
		"hooks:install": "bun x --bun lefthook install",
		"test:network": "bun run --cwd packages/headers build && bun scripts/smoke/network.ts",
		"test:release": "bun scripts/smoke/release.ts",
		"test:upgrade": "bun scripts/smoke/upgrade.ts",
		"check:deps": "bun x --bun depcruise --config .dependency-cruiser.json --output-type err apps packages",
		"check:sdk": "bun x --bun tsc --project packages/plugin-sdk/tsconfig.json"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@boathook/core": "workspace:*",
		"@boathook/plugin-sdk": "workspace:*",
		"@types/bun": "catalog:",
		"dependency-cruiser": "catalog:",
		"fast-check": "catalog:",
		"incur": "catalog:",
		"lefthook": "catalog:",
		"playwright": "catalog:",
		"typescript": "catalog:"
	},
	"patchedDependencies": {
		"patchright-core@1.58.2": "patches/patchright-core@1.58.2.patch"
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@axe-core/playwright": "^4.11.1",
			"@biomejs/biome": "^2.4.6",
			"@eslint-community/regexpp": "4.12.3",
			"@types/bun": "1.3.10",
			"@types/npm-package-arg": "6.1.4",
			"@types/proper-lockfile": "4.1.4",
			"@types/write-file-atomic": "4.0.3",
			"chrome-types": "0.1.464",
			"dependency-cruiser": "18.8.0",
			"fast-check": "^4.6.0",
			"incur": "0.9.0",
			"lefthook": "^2.1.4",
			"npm-package-arg": "14.0.0",
			"patchright-core": "1.58.2",
			"playwright": "npm:patchright@1.58.2",
			"playwright-core": "npm:patchright-core@1.58.2",
			"proper-lockfile": "4.1.2",
			"typescript": "^5",
			"write-file-atomic": "6.0.0"
		}
	}
}
